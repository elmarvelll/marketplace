# AkadVerse Marketplace (standalone app) — environment template.
# Copy to .env and fill in. Placeholders only: never commit real values. See README "Configuration".

# ---- Environment ------------------------------------------------------------------------------------------------
# local | test | staging | production. Must match the marker in the database (marketplace."MarketplaceInstance"):
# the app refuses to start against another environment's database.
MARKETPLACE_ENV="local"

# ---- Database: AkadVerse's database, as the RESTRICTED runtime role --------------------------------------------
# Never AkadVerse's DATABASE_URL / DIRECT_URL (full access) — the app refuses postgres/service_role/etc. outright.
# Local development (npm run db:up && npm run db:local:setup prints these):
AKADVERSE_DATABASE_URL="postgresql://marketplace_app:marketplace_app_local_only_0000@127.0.0.1:5434/akadverse_replica"
# Production (Supabase transaction pooler; user is "<role>.<project-ref>"):
# AKADVERSE_DATABASE_URL="postgresql://marketplace_app.PROJECT_REF:PASSWORD@aws-1-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Staging/production only: AkadVerse's Supabase project reference — the URL must be for this project.
# AKADVERSE_DB_PROJECT_REF="PROJECT_REF"

# ---- Migrations of the Marketplace-owned "marketplace" schema (NOT needed by the running app) ---------------------
# The marketplace_migrator role: owns only schema "marketplace", can't touch AkadVerse's tables. Keep it OUT of the
# deployment's runtime environment; set it only in the shell/CI job that runs npm run db:migrate.
MARKETPLACE_MIGRATION_DATABASE_URL="postgresql://marketplace_migrator:marketplace_migrator_local_only_0@127.0.0.1:5434/akadverse_replica?schema=marketplace"
# Production (Supabase session pooler):
# MARKETPLACE_MIGRATION_DATABASE_URL="postgresql://marketplace_migrator.PROJECT_REF:PASSWORD@aws-1-eu-north-1.pooler.supabase.com:5432/postgres?schema=marketplace"
# Required for staging/production migrations: the exact host you intend to change.
# MARKETPLACE_DB_CONFIRM_HOST="aws-1-eu-north-1.pooler.supabase.com"
# Only after reviewing a destructive Marketplace migration: its folder name(s), comma-separated.
# MARKETPLACE_ALLOW_DESTRUCTIVE=""

# Role provisioning (scripts/provision-db-roles.mjs) is run once by an operator with these set IN THEIR SHELL ONLY —
# never in this file or the deployment: PROVISION_ADMIN_DATABASE_URL, MARKETPLACE_APP_DB_PASSWORD,
# MARKETPLACE_MIGRATOR_DB_PASSWORD. See README "Database roles".

# ---- Sessions ---------------------------------------------------------------------------------------------------
# A secret generated for THIS app (openssl rand -base64 32). Never AkadVerse's NEXTAUTH_SECRET.
NEXTAUTH_SECRET="replace-with-a-new-random-secret"
# This app's public origin (auth callbacks, links in emails).
NEXTAUTH_URL="http://localhost:3000"
# AkadVerse's public origin — where people create their account (the Marketplace doesn't create accounts).
NEXT_PUBLIC_AKADVERSE_URL="http://localhost:3000"

# ---- Google sign-in (optional; existing AkadVerse accounts only) ------------------------------------------------
# If you reuse AkadVerse's Google OAuth client, add this app's redirect URI to it:
#   <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Paystack ---------------------------------------------------------------------------------------------------
# "test" (default) or "live": selects BOTH the secret key used by the server and the public key given to the browser.
# Sharing AkadVerse's Paystack account works (see README "Payments"); the webhook URL stays wherever it is now.
PAYSTACK_MODE="test"
PAYSTACK_TEST_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_PAYSTACK_KEY="pk_test_replace_me"
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_LIVE_KEY=""

# ---- Email (Resend) ---------------------------------------------------------------------------------------------
# Leave RESEND_API_KEY empty in development: emails are then printed to the server log instead of being sent.
RESEND_API_KEY=""
MARKETPLACE_EMAIL_FROM="AkadVerse Marketplace <marketplace@example.com>"
# Inbox for admin notifications, and the fallback support contact in emails.
ADMIN_EMAIL=""
SUPPORT_CONTACT=""
# Support address shown in the site footer (public).
NEXT_PUBLIC_SUPPORT_EMAIL=""
# Origin used for links in emails if it differs from NEXTAUTH_URL.
# APP_BASE_URL=""

# ---- Vendor Market delivery codes ------------------------------------------------------------------------------
# Server key for the students' six-digit delivery codes (hashed + encrypted at rest — src/lib/delivery-code.ts).
# A long random value, e.g. `openssl rand -base64 48`. Falls back to NEXTAUTH_SECRET when empty. Changing it makes
# every outstanding code unusable (admins can reissue one from Delivery operations).
DELIVERY_CODE_SECRET=""

# ---- Images (Cloudinary) ----------------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Scheduled jobs ---------------------------------------------------------------------------------------------
# Shared secret for /api/cron/* ("Authorization: Bearer <value>"). Use a value of this app's own, not AkadVerse's.
CRON_SECRET="replace-with-a-random-secret"
# AkadVerse runs the shared scheduled jobs (payouts, auto-reject, deliverer emails...). Set to "enabled" ONLY after
# they are switched off in AkadVerse, or every job runs twice against the same rows. README "Scheduled jobs".
MARKETPLACE_SCHEDULED_JOBS=""
