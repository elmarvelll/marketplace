{
  "name": "akadverse-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "AkadVerse Marketplace — standalone application (own deployment and sessions) on AkadVerse's live database, with a restricted database role.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --experimental-test-module-mocks --test --test-concurrency=1 \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:db:setup": "node tests/helpers/setup-test-db.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:local:setup": "node scripts/setup-local-db.mjs",
    "db:roles:print": "node scripts/provision-db-roles.mjs --print",
    "db:roles:apply": "node scripts/provision-db-roles.mjs --apply",
    "db:check": "node scripts/db-guard.mjs check",
    "db:status": "node scripts/db-guard.mjs status",
    "db:migrate": "node scripts/db-guard.mjs migrate-deploy",
    "db:verify": "tsx scripts/db-verify.ts",
    "schema:sync": "node scripts/sync-shared-schema.mjs",
    "schema:check": "node scripts/sync-shared-schema.mjs --check",
    "admin:grant": "tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-auth": "^4.24.15",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
